version: '3.8'
services:
postgres:
image: postgres:15
environment:
POSTGRES_DB: vitalparks
POSTGRES_USER: admin
POSTGRES_PASSWORD: changeme
volumes:
- postgres_data:/var/lib/postgresql/data
ports:
- "5432:5432"
airflow:
image: apache/airflow:2.9.0
environment:
AIRFLOW__CORE__EXECUTOR: LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN: postgre
volumes:
- ./dags:/opt/airflow/dags
- ./logs:/opt/airflow/logs
ports:
- "8080:8080"
depends_on:
- postgres
jupyter:
image: jupyter/scipy-notebook
volumes:
- .:/home/jovyan/work
ports:
- "8888:8888"
volumes:
postgres_data:
